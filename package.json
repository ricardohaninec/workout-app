{
  "name": "workout-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0",
    "db:init": "tsx --env-file=.env.local scripts/init-db.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate-workout-items.ts",
    "db:test": "tsx --env-file=.env.local scripts/test-db.ts",
    "db:migrate-wip": "tsx --env-file=.env.local scripts/migrate-workout-in-progress.ts",
    "db:migrate-item-note": "tsx --env-file=.env.local scripts/migrate-add-item-note.ts",
    "db:migrate-set-complete": "tsx --env-file=.env.local scripts/migrate-add-set-complete.ts",
    "db:migrate-rest-seconds": "tsx --env-file=.env.local scripts/migrate-add-rest-seconds.ts",
    "db:migrate-diet": "tsx --env-file=.env.local scripts/migrate-add-diet.ts",
    "db:migrate-wip-cascade": "tsx --env-file=.env.local scripts/migrate-workout-in-progress-set-cascade.ts",
    "db:migrate-set-unique": "tsx --env-file=.env.local scripts/migrate-add-set-unique-constraints.ts",
    "db:migrate-archived": "tsx --env-file=.env.local scripts/migrate-add-archived.ts",
    "db:migrate-hand-reference": "tsx --env-file=.env.local scripts/migrate-add-hand-reference.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@serwist/next": "^9.5.7",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@vercel/blob": "^2.3.1",
    "barcode-detector": "^3.2.3",
    "better-auth": "^1.5.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "serwist": "^9.5.7",
    "shadcn": "^4.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "overrides": {
    "minimatch": "^10.0.0"
  }
}
